# Only with Linear as the tracker: your personal API key (Settings → API → Personal API keys).
# GitHub Issues uses your gh sign-in instead.
LINEAR_API_KEY=lin_api_xxx

# Optional: Telegram bot token from @BotFather, and YOUR chat id (talk to @userinfobot).
# Without them mevo runs without the bot.
TELEGRAM_BOT_TOKEN=123456:ABC
TELEGRAM_CHAT_ID=123456789

# Required when server.tunnel is true. Long random string: openssl rand -hex 24
# DASHBOARD_TOKEN=

# Optional: where the daemon keeps state + logs (default ./data)
# METWO_DATA_DIR=./data

# Optional: Chrome for the GitHub sign-in window (default: the macOS app)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Optional: Figma personal access token, read-only (Figma → Settings → Security → Personal access
# tokens, scope "File content: read"). Lets lanes use the Figma frames linked in a ticket.
# FIGMA_TOKEN=figd_xxx

# Optional: Slack (a Slack app you create for your workspace; switches in Settings → Integrations)
# Bot token, scopes chat:write, im:write, users:read, users:read.email, channels:read, groups:read:
# DMs you what Telegram sends, posts PRs and the review summary to a channel (it must be invited:
# /invite @yourbot), lists the channels it can post to, finds PR authors in Slack by email
# SLACK_BOT_TOKEN=xoxb-xxx
# User token, scopes search:read, channels:history, groups:history, im:history, mpim:history,
# users:read, chat:write, im:write, im:read, users.profile:read: reads your mentions and linked
# threads, posts the replies you send, the review follow-up DMs you send to PR authors, and for
# Night Shift your DMs and your Slack status
# SLACK_USER_TOKEN=xoxp-xxx
# Your member id (profile → ⋯ → Copy member ID)
# SLACK_USER_ID=U0XXXXXXX
