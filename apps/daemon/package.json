{
  "name": "@ticketflow/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "tsx --env-file-if-exists=../../.env src/index.ts",
    "dev": "METWO_DEV=1 tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@linear/sdk": "^61.0.0",
    "@mevo/mascot": "workspace:*",
    "@ticketflow/shared": "workspace:*",
    "grammy": "^1.40.0",
    "hono": "^4.10.4",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
