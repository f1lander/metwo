{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "metwo",
  "version": "0.1.0",
  "identifier": "com.coderoasters.metwo",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ticketflow/web dev",
    "beforeBuildCommand": "pnpm --filter @ticketflow/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "metwo",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0f1012"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
