{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mevo",
  "version": "0.1.0",
  "identifier": "com.coderoasters.metwo",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @ticketflow/web dev",
    "beforeBuildCommand": "pnpm --filter @ticketflow/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mevo",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0f1012"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http://localhost:4747 http://127.0.0.1:4747 https:",
        "media-src": "'self' blob: http://localhost:4747 http://127.0.0.1:4747 https:",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:4747 http://127.0.0.1:4747",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
