{
  "name": "ticketflow",
  "private": true,
  "version": "0.1.0",
  "description": "mevo: an issue (Linear or GitHub) → worktree → a headless AI lane → draft PR, driven from a board, the menu bar and Telegram",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "METWO_DEV=1 pnpm --filter @ticketflow/desktop dev",
    "app:build": "pnpm --filter @ticketflow/desktop build:app",
    "daemon": "pnpm --filter @ticketflow/daemon serve",
    "dev": "pnpm -r --parallel dev",
    "dev:daemon": "pnpm --filter @ticketflow/daemon dev",
    "dev:web": "pnpm --filter @ticketflow/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @ticketflow/daemon start",
    "typecheck": "pnpm -r typecheck",
    "init:repo": "pnpm --filter @ticketflow/daemon exec tsx src/init.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
