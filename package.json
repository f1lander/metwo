{
  "name": "ticketflow",
  "private": true,
  "version": "0.1.0",
  "description": "mevo: Linear \u2192 worktree \u2192 headless Claude \u2192 draft PR, driven from Telegram, a board and the menu bar",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "METWO_DEV=1 pnpm --filter @ticketflow/desktop dev",
    "app:build": "pnpm --filter @ticketflow/desktop build:app",
    "daemon": "pnpm --filter @ticketflow/daemon serve",
    "dev": "pnpm -r --parallel dev",
    "dev:daemon": "pnpm --filter @ticketflow/daemon dev",
    "dev:web": "pnpm --filter @ticketflow/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @ticketflow/daemon start",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
